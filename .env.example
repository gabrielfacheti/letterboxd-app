# Copie para .env e preencha. O .env nunca deve ser versionado.

# Chave v3 do TMDB: https://www.themoviedb.org/settings/api
TMDB_KEY=

# Onde fica o cache local de metadados do TMDB.
LETTERBOXD_DATA_DIR=./data

# Só no servidor: token do túnel, em Cloudflare Zero Trust → Networks → Tunnels.
TUNNEL_TOKEN=
